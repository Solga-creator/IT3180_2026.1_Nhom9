        <mxCell id="cell_WF-03_04_Apartments_4" value="WF-03: Form Lưu Căn hộ &amp; Diện tích (US-001)&#xa;Số phòng (*): [ 050 ]&#xa;Diện tích m² (*): [ 60.5 ]&#xa;[ Lưu căn hộ ]" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;fontColor=#0f172a;strokeColor=#94a3b8;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="260" y="135" width="360" height="150" as="geometry"/></mxCell>
        <mxCell id="cell_WF-03_04_Apartments_5" value="WF-04: Trạng thái Báo lỗi (US-001)&#xa;[!] Số phòng đã tồn tại hoặc Diện tích &lt;= 0&#xa;Số phòng (*): [ 050 ] (Trùng)&#xa;Diện tích m² (*): [ -10 ]" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#fff1f2;fontColor=#be123c;strokeColor=#94a3b8;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="640" y="135" width="360" height="150" as="geometry"/></mxCell>
        <mxCell id="cell_WF-03_04_Apartments_6" value="Bảng Danh mục Căn hộ (Căn cứ tính phí m² cho Sprint 2 — Không dùng 450m² khu đất)&#xa;---------------------------------------------------------------------------------&#xa;Mã căn | Số phòng (Text) | Diện tích (m²) | Trạng thái Hộ | Ngày cập nhật&#xa;#1     | 050             | 60.00 m²       | Đã có chủ hộ  | 2026-11-04&#xa;#2     | 101             | 75.50 m²       | Chưa có hộ    | 2026-11-04" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;fontColor=#0f172a;strokeColor=#94a3b8;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="260" y="300" width="740" height="180" as="geometry"/></mxCell>
