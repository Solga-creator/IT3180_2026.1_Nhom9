        <mxCell id="cell_WF-05_08_Residents_2" value="SIDEBAR (AppLayout)&#xa;&#xa;  Trang chủ &amp; Căn hộ&#xa;&gt; Hộ &amp; Nhân khẩu&#xa;  Cấp tài khoản BQT&#xa;  Hồ sơ cá nhân&#xa;&#xa;[ Đăng xuất ]" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#1e293b;fontColor=#ffffff;strokeColor=#94a3b8;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="200" height="480" as="geometry"/></mxCell>
        <mxCell id="cell_WF-05_08_Residents_3" value="WF-05: Form Thêm Chủ hộ &amp; Nhân khẩu (US-002)&#xa;Căn hộ (*): [ Phòng 050 (60 m²) v ]&#xa;Họ tên (*): [ Trần Văn An ]&#xa;Ngày sinh (*): [ 1985-05-12 ]&#xa;Quan hệ với chủ hộ (*): [ Chủ hộ v ]&#xa;[ Thêm nhân khẩu ]" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;fontColor=#0f172a;strokeColor=#94a3b8;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="260" y="60" width="360" height="190" as="geometry"/></mxCell>
