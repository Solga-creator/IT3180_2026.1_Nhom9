        <mxCell id="cell_WF-09_10_Accounts_2" value="SIDEBAR (ADMIN)&#xa;&#xa;  Trang chủ &amp; Căn hộ&#xa;  Hộ &amp; Nhân khẩu&#xa;&gt; Cấp tài khoản BQT&#xa;  Hồ sơ cá nhân&#xa;&#xa;[ Đăng xuất ]" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#1e293b;fontColor=#ffffff;strokeColor=#94a3b8;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="200" height="400" as="geometry"/></mxCell>
        <mxCell id="cell_WF-09_10_Accounts_3" value="WF-09: Form Cấp tài khoản BQT mới (Chỉ ADMIN — US-015)&#xa;Tên đăng nhập (*): [ bqt_ketoan ]   Họ và tên (*): [ Lê Thị Kế Toán ]&#xa;Mật khẩu khởi tạo (&gt;=6 ký tự) (*): [ •••••••• ]    [ Cấp tài khoản BQT ]" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;fontColor=#0f172a;strokeColor=#94a3b8;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="260" y="60" width="740" height="150" as="geometry"/></mxCell>
        <mxCell id="cell_WF-09_10_Accounts_4" value="Bảng Danh sách Tài khoản Thành viên BQT&#xa;------------------------------------------------&#xa;ID | Username   | Họ tên         | Role | Thao tác&#xa;1  | admin      | Quản trị viên  | ADMIN| (Mặc định)&#xa;2  | bqt_ketoan | Lê Thị Kế Toán | BQT  | [ Xóa ]" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;fontColor=#0f172a;strokeColor=#94a3b8;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="260" y="225" width="460" height="235" as="geometry"/></mxCell>
