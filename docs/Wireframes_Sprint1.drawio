        <mxCell id="cell_WF-03_04_Apartments_2" value="SIDEBAR (AppLayout)&#xa;&#xa;&gt; Trang chủ &amp; Căn hộ&#xa;  Hộ &amp; Nhân khẩu&#xa;  Cấp tài khoản BQT&#xa;  Hồ sơ cá nhân&#xa;&#xa;[ Đăng xuất ]" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#1e293b;fontColor=#ffffff;strokeColor=#94a3b8;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="200" height="420" as="geometry"/></mxCell>
