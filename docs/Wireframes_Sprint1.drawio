  <diagram id="WF-BASE_MasterLayout" name="WF-BASE_MasterLayout">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="650">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title_WF-BASE_MasterLayout" value="WF-BASE: Master Layout Base chuẩn bị cho 32 khung màn hình Thu phí Sprint 2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0f172a;fontColor=#ffffff;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="960" height="38" as="geometry"/></mxCell>
        <mxCell id="cell_WF-BASE_MasterLayout_2" value="MASTER SIDEBAR (AppLayout)&#xa;&#xa;[Phân hệ Sprint 1 - Done]&#xa;- Trang chủ &amp; Căn hộ&#xa;- Hộ &amp; Nhân khẩu&#xa;- Cấp tài khoản BQT&#xa;- Hồ sơ cá nhân&#xa;&#xa;[Base Menu chờ Sprint 2]&#xa;- Đơn giá &amp; Quỹ tự nguyện&#xa;- Bảng thu đầu tháng&#xa;- Thu phí &amp; Biên lai&#xa;- Công nợ &amp; Lịch sử đóng&#xa;- Xuất báo cáo thu Excel&#xa;- Phân quyền &amp; Audit Log" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#1e293b;fontColor=#ffffff;strokeColor=#94a3b8;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="220" height="460" as="geometry"/></mxCell>
