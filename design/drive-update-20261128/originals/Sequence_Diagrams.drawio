  <diagram id="yDvQCX4CmNujgDti91xZ" name="SEQ 05">
    <mxGraphModel dx="1701" dy="1101" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle SEQ-05: Cập nhật hồ sơ &amp; Đổi mật khẩu (US-017)\nautonumber\nskinparam responseMessageBelowArrow true\nskinparam maxMessageSize 180\nskinparam boxPadding 10\nskinparam participantPadding 12\n\nactor \&quot;Thành viên BQT\&quot; as User\n\nbox \&quot;Frontend (React)\&quot; #F8F9FA\n  boundary \&quot;ProfilePage\&quot; as UI\n  control \&quot;api.js\&quot; as APIClient\nend box\n\nbox \&quot;Backend (Express REST API)\&quot; #EBF3FB\n  control \&quot;authHandler\&quot; as Handler\n  control \&quot;authService\&quot; as Service\n  entity \&quot;userRepository\&quot; as Repo\nend box\n\nbox \&quot;Database\&quot; #F1F3F5\n  database \&quot;MySQL (users)\&quot; as DB\nend box\n\nUser -&gt; UI: Nhập currentPassword, newPassword &amp; bấm \&quot;Đổi mật khẩu\&quot;\nactivate UI\nUI -&gt; APIClient: post(&#39;/api/auth/password&#39;, { currentPassword, newPassword })\nactivate APIClient\nAPIClient -&gt; Handler: POST /api/auth/password (Bearer JWT)\nactivate Handler\nHandler -&gt; Service: updatePassword(req.user.id, currentPassword, newPassword)\nactivate Service\nService -&gt; Repo: findUserById(req.user.id)\nactivate Repo\nRepo -&gt; DB: SELECT * FROM users WHERE id = ?\nactivate DB\nDB --&gt; Repo: user record (có password_hash)\ndeactivate DB\nRepo --&gt; Service: user\ndeactivate Repo\n\nService -&gt; Service: bcrypt.compare(currentPassword, user.password_hash)\nalt Mật khẩu hiện tại đúng\n  Service -&gt; Service: bcrypt.hash(newPassword, 10)\n  Service -&gt; Repo: updateUserPassword(req.user.id, newHash)\n  activate Repo\n  Repo -&gt; DB: UPDATE users SET password_hash = ? WHERE id = ?\n  activate DB\n  DB --&gt; Repo: affectedRows: 1\n  deactivate DB\n  Repo --&gt; Service: void\n  deactivate Repo\n  Service --&gt; Handler: void\n  Handler --&gt; APIClient: 200 OK { success: true, message: \&quot;Đổi mật khẩu thành công.\&quot; }\n  APIClient --&gt; UI: 200 OK\n  UI --&gt; User: Thông báo \&quot;Đổi mật khẩu thành công\&quot; &amp; xóa form\nelse Mật khẩu hiện tại không đúng\n  Service --&gt; Handler: throw AppError(400, \&quot;Mật khẩu hiện tại không chính xác.\&quot;)\n  Handler --&gt; APIClient: 400 Bad Request\n  APIClient --&gt; UI: Lỗi 400\n  UI --&gt; User: Báo lỗi \&quot;Mật khẩu hiện tại không chính xác.\&quot;\nend\ndeactivate Service\ndeactivate Handler\ndeactivate APIClient\ndeactivate UI\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="QrRvSTXNDiSU47_tfS5K-1">
