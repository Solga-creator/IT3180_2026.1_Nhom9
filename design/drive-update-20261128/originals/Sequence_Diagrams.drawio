        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle SEQ-03: Cấp tài khoản thành viên BQT (US-015)\nautonumber\nskinparam responseMessageBelowArrow true\nskinparam maxMessageSize 180\nskinparam boxPadding 10\nskinparam participantPadding 12\n\nactor \&quot;Quản trị viên (ADMIN)\&quot; as Admin\n\nbox \&quot;Frontend (React)\&quot; #F8F9FA\n  boundary \&quot;IssueAccountPage\&quot; as UI\n  control \&quot;api.js\&quot; as APIClient\nend box\n\nbox \&quot;Backend (Express REST API)\&quot; #EBF3FB\n  control \&quot;requireAuth &amp; requireAdmin\&quot; as Middleware\n  control \&quot;accountHandler\&quot; as Handler\n  control \&quot;accountService\&quot; as Service\n  entity \&quot;userRepository\&quot; as Repo\nend box\n\nbox \&quot;Database\&quot; #F1F3F5\n  database \&quot;MySQL (users)\&quot; as DB\nend box\n\nAdmin -&gt; UI: Nhập username, fullName, password &amp; bấm \&quot;Cấp\&quot;\nactivate UI\nUI -&gt; APIClient: post(&#39;/api/accounts&#39;, data)\nactivate APIClient\nAPIClient -&gt; Middleware: POST /api/accounts (Header: Bearer AdminJWT)\nactivate Middleware\nMiddleware -&gt; Middleware: Kiểm tra req.user.role === &#39;ADMIN&#39;\nMiddleware -&gt; Handler: next() -&gt; issueAccount(req, res)\nactivate Handler\nHandler -&gt; Service: createAccount(req.body)\nactivate Service\n\nService -&gt; Service: validateIssueAccountInput(username, fullName, password)\nService -&gt; Repo: findUserByUsername(username)\nactivate Repo\nRepo -&gt; DB: SELECT id FROM users WHERE username = ?\nactivate DB\nDB --&gt; Repo: null (Chưa có ai dùng)\ndeactivate DB\nRepo --&gt; Service: null\ndeactivate Repo\n\nService -&gt; Service: bcrypt.hash(password, 10)\nService -&gt; Repo: createUser({ username, fullName, passwordHash, role: &#39;BQT&#39; })\nactivate Repo\nRepo -&gt; DB: INSERT INTO users (username, full_name, password_hash, role) VALUES (...)\nactivate DB\nDB --&gt; Repo: insertId: 12\ndeactivate DB\nRepo --&gt; Service: id: 12\ndeactivate Repo\n\nService -&gt; Repo: findUserById(12)\nactivate Repo\nRepo -&gt; DB: SELECT * FROM users WHERE id = 12\nactivate DB\nDB --&gt; Repo: User record mới tạo\ndeactivate DB\nRepo --&gt; Service: user object\ndeactivate Repo\n\nService --&gt; Handler: user mới (role: &#39;BQT&#39;)\nHandler --&gt; APIClient: 201 Created { success: true, data: user }\ndeactivate Service\ndeactivate Handler\ndeactivate Middleware\nAPIClient --&gt; UI: Phản hồi 201 Created\nUI -&gt; UI: Thêm tài khoản mới vào bảng danh sách\nUI --&gt; Admin: Thông báo \&quot;Cấp tài khoản thành công\&quot; &amp; xóa trắng form\ndeactivate APIClient\ndeactivate UI\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="kJZ6oy-Icf0V58hxrLbn-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
