    <mxGraphModel dx="1505" dy="974" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Class Diagram: Layered Architecture (Kiến trúc 5 Tầng REST API BlueMoon SE09)\nskinparam classAttributeIconSize 0\nskinparam classFontSize 12\nskinparam roundcorner 8\nskinparam shadowing false\nskinparam ranksep 45\nskinparam nodesep 40\n\npackage \&quot;1. Presentation Layer (HTTP Handlers)\&quot; #F8F9FA {\n  class AuthHandler {\n    + login(req, res, next): void\n    + currentUser(req, res, next): void\n    + saveProfile(req, res, next): void\n    + changePassword(req, res, next): void\n  }\n  class AccountHandler {\n    + issueAccount(req, res, next): void\n    + getAccounts(req, res, next): void\n    + removeAccount(req, res, next): void\n  }\n  class ApartmentHandler {\n    + createApartment(req, res, next): void\n    + getApartments(req, res, next): void\n  }\n  class ResidentHandler {\n    + createResident(req, res, next): void\n    + getResidents(req, res, next): void\n    + createResidencyEvent(req, res, next): void\n    + exportResidents(req, res, next): void\n  }\n}\n\npackage \&quot;2. Security &amp; Middleware Layer\&quot; #FFF9DB {\n  class AuthMiddleware {\n    + signToken(user: User): string\n    + requireAuth(req, res, next): void\n    + requireStaff(req, res, next): void\n    + requireAdmin(req, res, next): void\n  }\n  class AppError {\n    + statusCode: int\n    + message: string\n    + AppError(statusCode, message)\n  }\n}\n\npackage \&quot;3. Business Service Layer\&quot; #EBF3FB {\n  class AuthService {\n    + loginUser(username, password): object\n    + updateProfile(userId, data): object\n    + updatePassword(userId, oldPass, newPass): void\n  }\n  class AccountService {\n    + createAccount(input): User\n    + listAccounts(): User[]\n    + deleteAccount(id): void\n  }\n  class ApartmentService {\n    + saveApartment(input): Apartment\n    + getApartments(): Apartment[]\n  }\n  class ResidentService {\n    + addResident(input): Resident\n    + getResidents(search): Resident[]\n    + updateResidencyStatus(id, input, userId): Resident\n    + exportResidents(status): Buffer\n  }\n}\n\npackage \&quot;4. Data Access Repository Layer\&quot; #E6FCF5 {\n  class UserRepository {\n    + findUserByUsername(username): User\n    + findUserById(id): User\n    + createUser(data): int\n    + listUsers(): User[]\n    + deleteUserById(id): void\n    + updateUserProfile(id, data): void\n    + updateUserPassword(id, hash): void\n  }\n  class ApartmentRepository {\n    + insertApartment(data): int\n    + findAllApartments(): Apartment[]\n    + findApartmentByRoomNumber(room): Apartment\n    + findApartmentById(id): Apartment\n  }\n  class ResidentRepository {\n    + createResident(data): object\n    + listResidents(search): Resident[]\n    + createResidencyEvent(residentId, event, userId): Resident\n    + listResidentsByStatus(status): Resident[]\n  }\n}\n\npackage \&quot;5. Database Infrastructure\&quot; #F1F3F5 {\n  class DatabasePool &lt;&lt;Singleton&gt;&gt; {\n    - pool: MySQLPool\n    + getConnection(): Connection\n    + query(sql, params): Promise&lt;any&gt;\n    + migrate(): Promise&lt;void&gt;\n  }\n}\n\n&#39; Quan hệ gọi giữa các tầng\nAuthHandler ..&gt; AuthService : invokes\nAuthHandler ..&gt; AuthMiddleware : uses\nAccountHandler ..&gt; AccountService : invokes\nApartmentHandler ..&gt; ApartmentService : invokes\nResidentHandler ..&gt; ResidentService : invokes\n\nAuthService ..&gt; UserRepository : uses\nAuthService ..&gt; AppError : throws\nAccountService ..&gt; UserRepository : uses\nAccountService ..&gt; AppError : throws\nApartmentService ..&gt; ApartmentRepository : uses\nApartmentService ..&gt; AppError : throws\nResidentService ..&gt; ResidentRepository : uses\nResidentService ..&gt; AppError : throws\n\nUserRepository ..&gt; DatabasePool : executes SQL\nApartmentRepository ..&gt; DatabasePool : executes SQL\nResidentRepository ..&gt; DatabasePool : executes SQL\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="UvaI64bQrw77NcModGRx-1">
