        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Class Diagram: Domain Entities (Mô hình Thực thể Nghiệp vụ BlueMoon SE09)\nskinparam classAttributeIconSize 0\nskinparam classFontSize 12\nskinparam roundcorner 8\nskinparam shadowing false\nskinparam ranksep 48\nskinparam nodesep 42\n\nenum UserRole {\n  ADMIN\n  BQT\n  RESIDENT\n}\n\nenum ResidencyStatus {\n  THUONG_TRU: \&quot;Thường trú\&quot;\n  TAM_TRU: \&quot;Tạm trú\&quot;\n  TAM_VANG: \&quot;Tạm vắng\&quot;\n  CHUYEN_DEN: \&quot;Chuyển đến\&quot;\n  CHUYEN_DI: \&quot;Chuyển đi\&quot;\n}\n\nclass User {\n  - id: int\n  - username: string\n  - fullName: string\n  - phone: string\n  - passwordHash: string\n  - role: UserRole\n  - residentId: int\n  - createdAt: DateTime\n  --\n  + toPublicUser(): object\n}\n\nclass Apartment {\n  - id: int\n  - roomNumber: string\n  - area: float\n  - createdAt: DateTime\n  - updatedAt: DateTime\n  --\n  + getId(): int\n  + getRoomNumber(): string\n  + getArea(): float\n}\n\nclass Household {\n  - id: int\n  - apartmentId: int\n  - headResidentId: int\n  - createdAt: DateTime\n  - updatedAt: DateTime\n  --\n  + getId(): int\n  + getApartmentId(): int\n  + getHeadResidentId(): int\n}\n\nclass Resident {\n  - id: int\n  - householdId: int\n  - fullName: string\n  - birthDate: Date\n  - relationshipToHead: string\n  - currentStatus: ResidencyStatus\n  - statusStartDate: Date\n  - statusEndDate: Date\n  - createdAt: DateTime\n  - updatedAt: DateTime\n  --\n  + isHeadOfHousehold(): boolean\n  + getResidencyHistory(): ResidencyEvent[]\n}\n\nclass ResidencyEvent {\n  - id: int\n  - residentId: int\n  - status: ResidencyStatus\n  - startDate: Date\n  - endDate: Date\n  - recordedBy: int\n  - createdAt: DateTime\n  --\n  + getId(): int\n  + getDuration(): int\n}\n\n&#39; Mối quan hệ giữa các thực thể\nApartment \&quot;1\&quot; *-- \&quot;1\&quot; Household : belongs to &gt;\nHousehold \&quot;1\&quot; *-- \&quot;1..*\&quot; Resident : members &gt;\nHousehold \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Resident : headResident &gt;\nResident \&quot;1\&quot; *-- \&quot;0..*\&quot; ResidencyEvent : history &gt;\nUser \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ResidencyEvent : recordedBy &gt;\nUser \&quot;0..1\&quot; --&gt; \&quot;0..1\&quot; Resident : linkedResident &gt;\nUser ..&gt; UserRole : uses\nResident ..&gt; ResidencyStatus : uses\nResidencyEvent ..&gt; ResidencyStatus : uses\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="oX2yT7Q-9q_Fx4U-hjib-1">
