  <diagram name="Page-1" id="g29RzpPUGn_fsTdI-lt_">
    <mxGraphModel dx="1174" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Component Diagram: Kiến trúc Thành phần Client - Server (BlueMoon SE09)\nskinparam componentStyle uml2\nskinparam roundcorner 8\nskinparam shadowing false\nskinparam ranksep 48\nskinparam nodesep 36\nskinparam defaultTextAlignment center\n\npackage \&quot;Frontend Subsystem (React SPA - Port 5174)\&quot; #F8F9FA {\n  component [UI Pages &amp; Views\\n(HomePage, ResidentsPage, LoginPage)] as UI\n  component [React Router Engine\\n(App.jsx)] as Router\n  component [Auth Context &amp; State\\n(AuthProvider.jsx)] as AuthContext\n  component [HTTP API Client\\n(services/api.js)] as APIClient\n  \n  UI ..&gt; Router : uses\n  UI ..&gt; AuthContext : subscribes\n  UI ..&gt; APIClient : sends requests\n}\n\ninterface \&quot;HTTP REST API\\n(JSON / Excel Buffer)\&quot; as REST_API\n\nAPIClient ..&gt; REST_API : calls (Port 3001)\n\npackage \&quot;Backend Subsystem (Node.js &amp; Express - Port 3001)\&quot; #EBF3FB {\n  component [Express App &amp; Router\\n(app.js &amp; api/routes/)] as WebApp\n  component [Security &amp; Auth Middleware\\n(middlewares/auth.js)] as AuthMid\n  component [Request Handlers\\n(api/handlers/)] as Handlers\n  component [Validation Layer\\n(validators/)] as Validators\n  component [Business Services Core\\n(services/)] as Services\n  component [Excel Export Service\\n(ExcelJS Engine)] as ExcelExport\n  component [Repositories Layer\\n(repositories/)] as Repos\n  component [DB Connection Pool\\n(config/database.js)] as DBPool\n  \n  REST_API - WebApp\n  WebApp ..&gt; AuthMid : verifies token\n  WebApp ..&gt; Handlers : routes to\n  Handlers ..&gt; Validators : validates input\n  Handlers ..&gt; Services : invokes\n  Services ..&gt; ExcelExport : generates .xlsx\n  Services ..&gt; Repos : delegates data\n  Repos ..&gt; DBPool : executes SQL queries\n}\n\ninterface \&quot;MySQL Native Protocol\\n(TCP Port 3306)\&quot; as SQL_IF\n\nDBPool ..&gt; SQL_IF : manages pool\n\npackage \&quot;Database Subsystem (MySQL 8.0)\&quot; #F1F3F5 {\n  component [Database Instance\\n(bluemoon_se09)] as MySQL_DB {\n    portin \&quot; \&quot; as p1\n    database \&quot;users\&quot; as T_Users\n    database \&quot;apartments\&quot; as T_Apts\n    database \&quot;households\&quot; as T_Households\n    database \&quot;residents\&quot; as T_Residents\n    database \&quot;residency_events\&quot; as T_Events\n  }\n}\n\nSQL_IF - p1\np1 ..&gt; T_Users\np1 ..&gt; T_Apts\np1 ..&gt; T_Households\np1 ..&gt; T_Residents\np1 ..&gt; T_Events\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="0OQk1WMcgzvRYWp-ewm0-1">
