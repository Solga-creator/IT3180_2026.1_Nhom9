  <diagram id="kEIrpijqenkc_4eyUHIu" name="US-002_004_CuDan">
    <mxGraphModel dx="1468" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Activity Diagram: Thêm chủ hộ &amp; nhân khẩu (US-002)\nskinparam conditionStyle diamond\nskinparam defaultTextAlignment center\nskinparam roundcorner 8\nskinparam shadowing false\n\nskinparam ranksep 42\nskinparam nodesep 38\nskinparam padding 5\n\n|#F8F9FA|Thành viên BQT|\nstart\n:Mở mục \&quot;Hộ và nhân khẩu\&quot; (/residents);\n:Chọn căn hộ, nhập: Họ tên, Ngày sinh, Quan hệ;\n:Bấm nút \&quot;Thêm nhân khẩu\&quot;;\n\n|#EBF3FB|Hệ thống (BlueMoon SE09)|\n:Kiểm tra tính hợp lệ của dữ liệu nhập;\nif (Dữ liệu hợp lệ?) then ([Không])\n  :Hiển thị lỗi kiểm tra dữ liệu trên form;\n  stop\nelse ([Hợp lệ])\n  :Gửi yêu cầu POST /api/residents;\n  :Bắt đầu Database Transaction;\n  :Kiểm tra căn hộ tồn tại trong CSDL;\n  if (Căn hộ có tồn tại?) then ([Không tìm thấy])\n    :Rollback transaction;\n    :Báo lỗi 404 \&quot;Không tìm thấy căn hộ.\&quot;;\n    stop\n  else ([Tồn tại])\n    if (Quan hệ với chủ hộ là \&quot;Chủ hộ\&quot;?) then ([Là Chủ hộ])\n      :Kiểm tra căn hộ đã có chủ hộ chưa;\n      if (Căn hộ đã có chủ hộ?) then ([Đã có])\n        :Rollback transaction;\n        :Báo lỗi 409 \&quot;Căn hộ này đã có chủ hộ.\&quot;;\n        stop\n      else ([Chưa có])\n        :Thêm mới cư dân vào bảng residents;\n        :Cập nhật head_resident_id trong bảng households;\n        :Ghi nhận sự kiện cư trú ban đầu (Thường trú);\n        :COMMIT transaction;\n      endif\n    else ([Là Nhân khẩu khác])\n      :Kiểm tra căn hộ đã có chủ hộ hay chưa;\n      if (Đã có chủ hộ trước đó?) then ([Chưa có chủ hộ])\n        :Rollback transaction;\n        :Báo lỗi 400 \&quot;Hãy thêm chủ hộ trước khi thêm nhân khẩu.\&quot;;\n        stop\n      else ([Đã có chủ hộ])\n        :Thêm mới nhân khẩu vào bảng residents;\n        :Ghi nhận sự kiện cư trú ban đầu (Thường trú);\n        :COMMIT transaction;\n      endif\n    endif\n    \n    :Cập nhật danh sách cư dân trên màn hình;\n    :Hiển thị thông báo \&quot;Thêm cư dân thành công\&quot;;\n    \n|#F8F9FA|Thành viên BQT|\n    :Xem cư dân mới xuất hiện trong danh sách;\n    stop\n  endif\nendif\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="lTVnzqI3tt-DD8Yin0Ld-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
