  <diagram id="WF-13_16_FeeRates" name="WF-13_16_FeeRates">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="620">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title_WF-13_16_FeeRates" value="WF-13..16: Cấu hình &amp; Chốt đơn giá phí bắt buộc (US-006 — 4 khung)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0f172a;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="970" height="38" as="geometry"/></mxCell>
        <mxCell id="cell_WF-13_16_FeeRates_2" value="SIDEBAR (Kế toán / BQT)&#xa;&#xa;  Trang chủ &amp; Căn hộ&#xa;  Hộ &amp; Nhân khẩu&#xa;&gt; Đơn giá phí (US-006)&#xa;  Quỹ tự nguyện (US-007)&#xa;  Bảng thu tháng (US-008)&#xa;  Thu tiền &amp; Biên lai&#xa;  Công nợ &amp; Lịch sử" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#1e293b;fontColor=#ffffff;strokeColor=#94a3b8;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="210" height="460" as="geometry"/></mxCell>
        <mxCell id="cell_WF-13_16_FeeRates_3" value="WF-13 &amp; WF-14: Form Chốt Đơn giá (US-006)&#xa;Phí dịch vụ (2.500–16.500 đ/m²):&#xa;[ 6.000 ] VNĐ / m²&#xa;Phí quản lý (&gt;= 7.000 đ/m²):&#xa;[ 7.500 ] VNĐ / m²&#xa;Ngày áp dụng: [ 2026-11-01 ]&#xa;[ Chốt đơn giá áp dụng ]" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;fontColor=#0f172a;strokeColor=#94a3b8;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="270" y="60" width="360" height="200" as="geometry"/></mxCell>
        <mxCell id="cell_WF-13_16_FeeRates_4" value="WF-15: Trạng thái Báo lỗi Khung giá&#xa;[!] Lỗi kiểm tra nghiệp vụ:&#xa;- Phí dịch vụ phải từ 2.500 đến 16.500 đ/m²&#xa;- Phí quản lý phải từ 7.000 đ/m² trở lên&#xa;&#xa;Phí dịch vụ nhập: [ 2.000 ] (Không hợp lệ)&#xa;Phí quản lý nhập: [ 6.000 ] (Không hợp lệ)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#fff1f2;fontColor=#be123c;strokeColor=#94a3b8;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="650" y="60" width="360" height="200" as="geometry"/></mxCell>
        <mxCell id="cell_WF-13_16_FeeRates_5" value="WF-16: Bảng Lịch sử Thay đổi Đơn giá Phí Bắt buộc&#xa;-----------------------------------------------------------------------------&#xa;Ngày hiệu lực | Phí dịch vụ (đ/m²) | Phí quản lý (đ/m²) | Người chốt | Trạng thái&#xa;2026-11-01    | 6.000 đ/m²         | 7.500 đ/m²         | Kế toán 01 | Đang áp dụng&#xa;2026-01-01    | 5.000 đ/m²         | 7.000 đ/m²         | Quản trị   | Đã lưu trữ" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;fontColor=#0f172a;strokeColor=#94a3b8;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="270" y="280" width="740" height="240" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
