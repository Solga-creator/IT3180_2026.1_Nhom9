        <mxCell id="title_WF-21_24_MonthlyBilling" value="WF-21..24: Sinh bảng thu đầu tháng cho mọi căn hộ (US-008 — 4 khung)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0f172a;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="970" height="38" as="geometry"/></mxCell>
        <mxCell id="cell_WF-21_24_MonthlyBilling_2" value="SIDEBAR (Kế toán)&#xa;&#xa;  Đơn giá phí&#xa;  Quỹ tự nguyện&#xa;&gt; Bảng thu tháng (US-008)&#xa;  Giấy báo phí (US-009)&#xa;  Thu tiền &amp; Biên lai" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#1e293b;fontColor=#ffffff;strokeColor=#94a3b8;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="210" height="460" as="geometry"/></mxCell>
        <mxCell id="cell_WF-21_24_MonthlyBilling_3" value="WF-21: Thanh Chọn Kỳ Thu &amp; Sinh Bảng Thu Đầu Tháng&#xa;Chọn Tháng/Năm: [ 2026-11 v ]   Đơn giá áp dụng: DV 6.000đ/m² | QL 7.500đ/m²&#xa;[ + Sinh bảng thu đầu tháng cho tất cả căn hộ ]   (Công thức: Diện tích m² x Đơn giá)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#f8fafc;fontColor=#0f172a;strokeColor=#94a3b8;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="270" y="60" width="740" height="95" as="geometry"/></mxCell>
        <mxCell id="cell_WF-21_24_MonthlyBilling_4" value="WF-22: Modal Xác nhận Sinh Bảng Thu&#xa;Hệ thống sẽ tự động tạo hóa đơn tháng 11/2026 cho 24 căn hộ dựa trên apartments.area.&#xa;[ Hủy ]   [ Xác nhận sinh bảng thu ]" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#f0fdf4;fontColor=#166534;strokeColor=#94a3b8;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="270" y="170" width="360" height="130" as="geometry"/></mxCell>
        <mxCell id="cell_WF-21_24_MonthlyBilling_5" value="WF-24: Cảnh báo Chặn Sinh Trùng Kỳ (HTTP 409)&#xa;[!] Bảng thu kỳ 2026-11 đã được tạo trước đó.&#xa;Không thể sinh trùng lặp hóa đơn cùng kỳ." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#fff1f2;fontColor=#be123c;strokeColor=#94a3b8;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="650" y="170" width="360" height="130" as="geometry"/></mxCell>
        <mxCell id="cell_WF-21_24_MonthlyBilling_6" value="WF-23: Bảng Thu Phí Bắt Buộc Kỳ 2026-11&#xa;-----------------------------------------------------------------------------&#xa;Phòng | Diện tích | Phí DV (6.000) | Phí QL (7.500) | Tổng phải thu | Trạng thái&#xa;050   | 60.0 m²   | 360.000 đ      | 450.000 đ      | 810.000 đ     | CHƯA NỘP&#xa;101   | 75.5 m²   | 453.000 đ      | 566.250 đ      | 1.019.250 đ   | CHƯA NỘP" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;fontColor=#0f172a;strokeColor=#94a3b8;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="270" y="315" width="740" height="205" as="geometry"/></mxCell>
