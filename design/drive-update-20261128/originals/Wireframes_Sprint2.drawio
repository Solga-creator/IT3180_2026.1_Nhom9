        <mxCell id="cell_WF-25_27_FeeNotice_2" value="SIDEBAR (Kế toán)&#xa;&#xa;  Bảng thu tháng&#xa;&gt; Giấy báo phí (US-009)&#xa;  Thu tiền &amp; Biên lai&#xa;  Công nợ trong kỳ" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#1e293b;fontColor=#ffffff;strokeColor=#94a3b8;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="210" height="460" as="geometry"/></mxCell>
        <mxCell id="cell_WF-25_27_FeeNotice_3" value="WF-25: Chọn Căn Hộ &amp; Kỳ Thu Xem Giấy Báo Phí&#xa;Kỳ thu: [ 2026-11 v ]   Căn hộ: [ Phòng 050 - Chủ hộ: Trần Văn An v ]&#xa;[ Xem giấy báo ]   [ In giấy báo (A5/A4) ]" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#f8fafc;fontColor=#0f172a;strokeColor=#94a3b8;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="270" y="60" width="740" height="80" as="geometry"/></mxCell>
        <mxCell id="cell_WF-25_27_FeeNotice_4" value="WF-26: Mẫu Giấy Báo Phí Căn Hộ (Khổ A5/A4)&#xa;=============================================&#xa;      BAN QUẢN TRỊ CHUNG CƯ BLUEMOON SE09&#xa;          GIẤY BÁO PHÍ THÁNG 11/2026&#xa;---------------------------------------------&#xa;Căn hộ: 050 | Diện tích: 60.00 m²&#xa;Chủ hộ: Trần Văn An&#xa;---------------------------------------------&#xa;1. Phí dịch vụ (60 m² x 6.000đ):   360.000 VNĐ&#xa;2. Phí quản lý (60 m² x 7.500đ):   450.000 VNĐ&#xa;---------------------------------------------&#xa;TỔNG CỘNG PHẢI NỘP:                810.000 VNĐ&#xa;Hạn thanh toán: 15/11/2026" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;fontColor=#0f172a;strokeColor=#94a3b8;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="270" y="155" width="450" height="365" as="geometry"/></mxCell>
        <mxCell id="cell_WF-25_27_FeeNotice_5" value="WF-27: Khung Print Preview&#xa;&#xa;Cấu hình in trình duyệt:&#xa;- Khổ giấy: A5 / A4&#xa;- Lề: Chuẩn (10mm)&#xa;- Ẩn Sidebar &amp; Topbar&#xa;  (@media print)&#xa;&#xa;[ In ngay (Ctrl+P) ]&#xa;[ Lưu thành PDF ]" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#f8fafc;fontColor=#334155;strokeColor=#94a3b8;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="740" y="155" width="270" height="365" as="geometry"/></mxCell>
