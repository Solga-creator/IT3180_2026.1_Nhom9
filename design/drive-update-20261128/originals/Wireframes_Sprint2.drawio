        <mxCell id="title_WF-17_20_VoluntaryCampaigns" value="WF-17..20: Tạo &amp; Quản lý Đợt đóng góp tự nguyện (US-007 — 4 khung)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0f172a;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="970" height="38" as="geometry"/></mxCell>
        <mxCell id="cell_WF-17_20_VoluntaryCampaigns_2" value="SIDEBAR (BQT)&#xa;&#xa;  Đơn giá phí&#xa;&gt; Quỹ tự nguyện (US-007)&#xa;  Bảng thu tháng&#xa;  Thu tiền &amp; Biên lai&#xa;  Ghi nhận ủng hộ" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#1e293b;fontColor=#ffffff;strokeColor=#94a3b8;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="210" height="460" as="geometry"/></mxCell>
        <mxCell id="cell_WF-17_20_VoluntaryCampaigns_3" value="WF-18: Form Tạo Đợt Đóng Góp Tự Nguyện&#xa;Tên đợt (*): [ Ủng hộ Quỹ Khuyến học 2026 ]&#xa;Loại quỹ (*): [ Quỹ khuyến học v ]&#xa;Từ ngày: [ 2026-11-01 ] Đến: [ 2026-11-30 ]&#xa;Ghi chú: Tách riêng hoàn toàn phí bắt buộc&#xa;[ Tạo đợt đóng góp ]" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;fontColor=#0f172a;strokeColor=#94a3b8;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="270" y="60" width="360" height="210" as="geometry"/></mxCell>
        <mxCell id="cell_WF-17_20_VoluntaryCampaigns_4" value="WF-19: Trạng thái Báo lỗi Tạo Đợt&#xa;[!] Ngày kết thúc không được nhỏ hơn ngày bắt đầu&#xa;[!] Tên đợt vận động không được để trống&#xa;&#xa;WF-20: Thẻ Trạng thái Đợt&#xa;[ĐANG MỞ] Quỹ Khuyến học 2026&#xa;[ĐÃ ĐÓNG] Quỹ Vì người nghèo T10" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#fff1f2;fontColor=#be123c;strokeColor=#94a3b8;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="650" y="60" width="360" height="210" as="geometry"/></mxCell>
        <mxCell id="cell_WF-17_20_VoluntaryCampaigns_5" value="WF-17: Bảng Danh sách Đợt Đóng góp Tự nguyện (Tách khỏi Phí bắt buộc)&#xa;-----------------------------------------------------------------------------&#xa;Mã đợt | Tên đợt vận động          | Quỹ             | Thời gian      | Trạng thái&#xa;DG-01  | Ủng hộ Quỹ Khuyến học     | Khuyến học      | 01/11 – 30/11  | Đang mở&#xa;DG-02  | Quỹ Vì người nghèo 2026   | Vì người nghèo  | 01/10 – 31/10  | Đã đóng" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;fontColor=#0f172a;strokeColor=#94a3b8;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="270" y="290" width="740" height="230" as="geometry"/></mxCell>
